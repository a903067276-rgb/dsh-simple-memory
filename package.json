{
  "name": "dsh-simple-memory",
  "version": "0.2.0",
  "description": "Simple memory keeper for DSH: semi-automatic markdown accumulation, layered loading (global/project), cross-project search",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "memory",
    "markdown"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/a903067276-rgb/dsh-simple-memory.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7"
  }
}
